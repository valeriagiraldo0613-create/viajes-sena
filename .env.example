# CONFIGURACIÓN DEL SERVIDOR Y BASE DE DATOS
# Copia este archivo a .env para personalizar tu entorno

# Puerto del Servidor
PORT=3000
NODE_ENV=development

# Configuración de Base de Datos (Supabase / PostgreSQL / MongoDB)
# DB_TYPE: 'json' (almacenamiento local automático), 'postgres' o 'mongodb'
DB_TYPE=json

# Cadena de conexión PostgreSQL / Supabase
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/wandersquad_db

# O Cadena de conexión MongoDB Atlas (Opcional)
MONGODB_URI=mongodb+srv://admin:[PASSWORD]@cluster0.mongodb.net/wandersquad?retryWrites=true&w=majority

# Clave secreta para tokens JWT y sesiones
JWT_SECRET=sena_hackathon_super_secret_jwt_key_2026

# Configuración de CORS
CORS_ORIGIN=*
